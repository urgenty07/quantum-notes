---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { competitionAchievements } from "../data/competitions";
import { publishedPosts } from "../utils/content";

const competitionPosts = publishedPosts(await getCollection("blog")).filter((post) => post.data.category === "Competitions");
---

<BaseLayout title="Competitions" description="我的竞赛经历、解题过程与赛后复盘。">
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">Pillar 02 / Practice</p>
      <h1>我的竞赛</h1>
      <p>关注问题拆解、策略选择、团队协作和实战中形成的判断。</p>
    </header>
    <section class="competition-showcase page-section section-compact" aria-labelledby="competition-achievements-title">
      <div class="section-heading">
        <div><p class="section-kicker">Achievements</p><h2 id="competition-achievements-title">竞赛成果</h2></div>
        <p>只保留赛事与成果信息，个人身份信息不公开。</p>
      </div>
      <div class="competition-grid">
        {competitionAchievements.map((achievement) => (
          <article class="achievement-certificate">
            <div class="certificate-frame">
              <header class="certificate-head">
                <span>Honor archive / {achievement.index}</span>
                <time datetime="2026-08">{achievement.date}</time>
              </header>
              <div class="certificate-body">
                <p class="certificate-kicker">Certificate of Achievement</p>
                <h2>荣誉证书</h2>
                <div class="certificate-rule" aria-hidden="true"><span></span></div>
                <p class="certificate-intro">兹记录该参赛团队于</p>
                <h3>{achievement.event}</h3>
                <p class="certificate-group">{achievement.stage} · {achievement.group}</p>
                <div class="certificate-result">
                  <span>荣获</span>
                  <strong>{achievement.award}</strong>
                </div>
              </div>
              <section class="certificate-project" aria-label="参赛项目信息">
                <div>
                  <span>参赛项目 / Project</span>
                  <h4>{achievement.project}</h4>
                  <p>{achievement.summary}</p>
                </div>
                <ul aria-label="项目关键词">
                  {achievement.topics.map((topic) => <li>{topic}</li>)}
                </ul>
              </section>
              <footer class="certificate-footer">
                <span>Verified achievement</span>
                <span>Privacy-redacted · Text-only record</span>
              </footer>
            </div>
          </article>
        ))}
      </div>
    </section>
    {competitionPosts.length > 0 && (
      <section class="page-section" aria-label="竞赛复盘">
        <div class="section-heading"><div><p class="section-kicker">Competition log</p><h2>参赛复盘</h2></div></div>
        <div class="post-list">
        {competitionPosts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
