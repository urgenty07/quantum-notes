---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { publishedPosts, withBase } from "../utils/content";

const posts = publishedPosts(await getCollection("blog"));
const latestPosts = posts.slice(0, 3);
const pillars = [
  { href: "/stack", label: "Stack", title: "我的技术栈", detail: "语言、科学计算、量子软件与 Web 工具链。", meta: "Languages · Tools · Systems" },
  { href: "/competitions", label: "Contests", title: "我的竞赛", detail: "赛事经历、解题过程、协作角色与赛后复盘。", meta: "Practice · Review · Growth" },
  { href: "/research", label: "Research", title: "我的科研", detail: "研究方向、实验进展与阶段性理解；论文阅读只是其中一部分。", meta: "Quantum · Tensor · QML" },
  { href: "/projects", label: "Projects", title: "我的项目", detail: "从原型、实现到持续维护的完整作品。", meta: "Build · Ship · Iterate" }
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="section-kicker">Independent developer · research builder</p>
        <h1>Learn deeply.<br /><span>Build boldly.</span></h1>
        <p class="hero-lead">技术、竞赛、科研与项目，构成同一条成长路径。</p>
        <p class="hero-detail">这里记录能力如何形成、问题如何被解决，以及想法如何变成真正可运行的作品。</p>
        <div class="hero-actions">
          <a class="button" href="#pillars"><span>探索四个方向</span><span aria-hidden="true">↓</span></a>
          <a class="button secondary" href={withBase("/projects")}>查看项目</a>
        </div>
      </div>
      <aside class="hero-console" aria-label="当前关注方向">
        <div class="console-header">
          <span>Field notes / 001</span>
          <span>Zephyr</span>
        </div>
        <div class="console-visual" aria-hidden="true">
          <span class="axis axis-x"></span>
          <span class="axis axis-y"></span>
          <span class="quantum-haze"></span>
          <span class="quantum-scan quantum-scan-one"></span>
          <span class="quantum-scan quantum-scan-two"></span>
          <span class="orbit orbit-one"><i></i></span>
          <span class="orbit orbit-two"><i></i></span>
          <span class="orbit orbit-three"><i></i></span>
          <span class="quantum-spark spark-one"></span>
          <span class="quantum-spark spark-two"></span>
          <span class="quantum-spark spark-three"></span>
          <span class="orbit-core"><span></span><strong>Ψ</strong></span>
        </div>
      </aside>
      <div class="hero-caption" aria-hidden="true">
        <span>01</span><span>Personal technical space</span>
      </div>
    </div>
  </section>

  <section class="page-section container" id="pillars" aria-labelledby="focus-title">
    <div class="section-heading">
      <div><p class="section-kicker">Explore / 01</p><h2 id="focus-title">四个方向</h2></div>
      <p>不是四个孤立栏目，而是从学习、实战、探索到交付的完整闭环。</p>
    </div>
    <div class="pillar-grid">
      {pillars.map((item, index) => (
        <a class="pillar-card" href={withBase(item.href)}>
          <span class="focus-number">0{index + 1}</span>
          <span class="pillar-label">{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
          <small>{item.meta}</small>
          <span class="pillar-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section container" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><p class="section-kicker">Recent / 02</p><h2 id="latest-title">最近更新</h2></div>
      <a href={withBase("/blog")}>全部笔记 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="post-grid">{latestPosts.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="page-section container" aria-labelledby="about-title">
    <div class="about-panel">
      <div class="about-heading"><p class="section-kicker">About / 03</p><h2 id="about-title">让成长，<br />留下结构。</h2><span aria-hidden="true">Z / 04</span></div>
      <div>
        <p class="about-lead">这里不是单一主题的论文笔记库，而是一张持续生长的个人能力地图。</p>
        <p>技术栈提供方法，竞赛锻炼实战，科研推进探索，项目沉淀结果。</p>
        <div class="hero-actions"><a class="button secondary" href={withBase("/about")}>关于我</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
