---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { publishedPosts, withBase } from "../utils/content";

const posts = publishedPosts(await getCollection("blog"));
const latestPosts = posts.slice(0, 3);
const focusAreas = [
  { title: "Personal Projects", detail: "把想法变成可运行、可迭代的作品。" },
  { title: "Code & Systems", detail: "记录工程实践、工具链与编程思考。" },
  { title: "Quantum Computing", detail: "探索计算、算法与量子软件。" },
  { title: "Research Reading", detail: "论文阅读只是持续学习的一部分。" }
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="section-kicker">Independent developer · field notes</p>
        <h1>Build ideas.<br /><span>Leave a trace.</span></h1>
        <p class="hero-lead">把想法做成作品，也把探索过程留在这里。</p>
        <p class="hero-detail">一个关于个人项目、代码与系统、量子计算和持续学习的技术空间。</p>
        <div class="hero-actions">
          <a class="button" href={withBase("/projects")}><span>查看项目</span><span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={withBase("/blog")}>浏览笔记</a>
        </div>
      </div>
      <aside class="hero-console" aria-label="当前关注方向">
        <div class="console-header">
          <span>Field notes / 001</span>
          <span>Zephyr</span>
        </div>
        <div class="console-visual" aria-hidden="true">
          <span class="orbit orbit-one"></span>
          <span class="orbit orbit-two"></span>
          <span class="orbit-core">ψ</span>
          <span class="axis axis-x"></span>
          <span class="axis axis-y"></span>
        </div>
        <dl class="console-list">
          <div><dt>Build</dt><dd>Personal tools & experiments</dd></div>
          <div><dt>Explore</dt><dd>Code · Systems · Quantum</dd></div>
          <div><dt>Write</dt><dd>Notes in progress</dd></div>
        </dl>
      </aside>
      <div class="hero-caption" aria-hidden="true">
        <span>01</span><span>Personal technical space</span>
      </div>
    </div>
  </section>

  <section class="page-section container" aria-labelledby="focus-title">
    <div class="section-heading">
      <div><p class="section-kicker">Explore / 01</p><h2 id="focus-title">我在做什么</h2></div>
      <p>从工程实践到长期研究，保持开放的兴趣边界。</p>
    </div>
    <div class="focus-grid">
      {focusAreas.map((item, index) => (
        <article class="focus-item">
          <span class="focus-number">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section container" aria-labelledby="projects-title">
    <div class="section-heading">
      <div><p class="section-kicker">Building / 02</p><h2 id="projects-title">正在构建</h2></div>
      <a href={withBase("/projects")}>全部项目 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}</div>
  </section>

  <section class="page-section container" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><p class="section-kicker">Notes / 03</p><h2 id="latest-title">最近笔记</h2></div>
      <a href={withBase("/blog")}>全部笔记 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="post-grid">{latestPosts.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="page-section container" aria-labelledby="about-title">
    <div class="about-panel">
      <div class="about-heading"><p class="section-kicker">About / 04</p><h2 id="about-title">做项目，<br />也记录过程。</h2><span aria-hidden="true">Z / 04</span></div>
      <div>
        <p class="about-lead">这里不是单一主题的知识库，而是一张持续生长的个人技术地图。</p>
        <p>用于发布项目、整理代码与工程经验，也记录量子计算、论文阅读和算法实现中的学习过程。</p>
        <div class="hero-actions"><a class="button secondary" href={withBase("/about")}>关于我</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
