---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { publishedPosts, withBase } from "../utils/content";

const posts = publishedPosts(await getCollection("blog"));
const latestPosts = posts.slice(0, 3);
const focusAreas = [
  { title: "Personal Projects", detail: "把想法变成可运行、可迭代的作品。" },
  { title: "Code & Systems", detail: "记录工程实践、工具链与编程思考。" },
  { title: "Quantum Computing", detail: "探索计算、算法与量子软件。" },
  { title: "Research Reading", detail: "论文阅读只是持续学习的一部分。" }
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="section-kicker">Projects · code · exploration</p>
        <h1>Build ideas.<br /><span>Keep exploring.</span></h1>
        <p>一个关于项目实践、编程、量子计算与持续学习的个人空间。</p>
        <p>这里既记录 Quantum Computing 和研究笔记，也分享我正在构建的工具、实验与长期项目。</p>
        <div class="hero-actions">
          <a class="button" href={withBase("/projects")}>查看项目</a>
          <a class="button secondary" href={withBase("/blog")}>浏览笔记</a>
        </div>
      </div>
      <div class="quantum-mark" aria-hidden="true">
        <span class="quantum-ring"></span>
        <span class="quantum-core"></span>
        <span class="quantum-symbol">ψ</span>
      </div>
    </div>
  </section>

  <section class="page-section container" aria-labelledby="focus-title">
    <div class="section-heading">
      <div><p class="section-kicker">Explore</p><h2 id="focus-title">我在做什么</h2></div>
    </div>
    <div class="focus-grid">
      {focusAreas.map((item, index) => (
        <article class="focus-item">
          <span class="focus-number">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section container" aria-labelledby="projects-title">
    <div class="section-heading">
      <div><p class="section-kicker">Building</p><h2 id="projects-title">正在构建</h2></div>
      <a href={withBase("/projects")}>全部项目 →</a>
    </div>
    <div class="projects-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section class="page-section container" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><p class="section-kicker">Notes</p><h2 id="latest-title">最近笔记</h2></div>
      <a href={withBase("/blog")}>全部笔记 →</a>
    </div>
    <div class="post-grid">{latestPosts.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="page-section container" aria-labelledby="about-title">
    <div class="about-panel">
      <div><p class="section-kicker">About</p><h2 id="about-title">做项目，也记录过程。</h2></div>
      <div>
        <p>这是一个个人技术空间：用于发布项目、整理代码与工程经验，也记录量子计算、论文阅读和算法实现中的学习过程。</p>
        <div class="hero-actions"><a class="button secondary" href={withBase("/about")}>关于我</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
