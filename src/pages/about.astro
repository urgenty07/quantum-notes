---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout title="About" description={`关于 ${siteConfig.author} 与这个技术博客。`}>
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">Profile</p>
      <h1>About</h1>
      <p>你好，我是 {siteConfig.author}。</p>
    </header>
    <section class="about-panel" aria-labelledby="about-content-title">
      <div><h2 id="about-content-title">学习、实现、记录。</h2></div>
      <div>
        <p>我关注项目实践、编程、工具构建与 Quantum Computing。这个网站用于展示个人项目，记录代码与工程经验，也保留论文阅读、算法实现和学习过程。</p>
        <p style="margin-top: 1rem;">我希望这里既能沉淀可复用的笔记，也能留下从想法到作品的完整过程。</p>
        <div class="hero-actions">
          <a class="button secondary" href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          {siteConfig.email && <a class="button secondary" href={`mailto:${siteConfig.email}`}>Email</a>}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
