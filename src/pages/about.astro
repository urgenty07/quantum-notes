---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout title="About" description={`关于 ${siteConfig.author} 与这个技术博客。`}>
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">Index / Profile</p>
      <h1>About</h1>
      <p>你好，我是 {siteConfig.author}。</p>
    </header>
    <section class="about-panel" aria-labelledby="about-content-title">
      <div><h2 id="about-content-title">学习、实践、研究、创造。</h2></div>
      <div>
        <p>这个网站围绕技术栈、竞赛、科研和项目四条主线展开：技术栈记录能力的形成，竞赛沉淀实战判断，科研追踪问题与实验，项目展示从想法到交付的完整过程。</p>
        <p style="margin-top: 1rem;">论文阅读是科研过程中的一项工具，而不是网站的全部；我更希望这里最终呈现持续成长的轨迹。</p>
        <div class="hero-actions">
          <a class="button secondary" href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          {siteConfig.email && <a class="button secondary" href={`mailto:${siteConfig.email}`}>Email</a>}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
