---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/content";
---

<BaseLayout title="页面未找到" description="请求的页面不存在。">
  <section class="not-found">
    <strong>404</strong>
    <h1>这个状态不在希尔伯特空间里。</h1>
    <p>页面可能已移动，或 URL 输入有误。</p>
    <div><a class="button" href={withBase("/")}>返回首页</a></div>
  </section>
</BaseLayout>
