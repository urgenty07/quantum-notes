---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { publishedPosts } from "../utils/content";

const stackGroups = [
  {
    index: "01",
    discipline: "Foundation",
    title: "编程语言与基础",
    detail: "用于算法原型、工程实现和自动化脚本。",
    groups: [
      { label: "Languages", items: ["Python", "TypeScript", "JavaScript"] },
      { label: "Practice", items: ["Algorithm Prototyping", "Automation", "Tooling"] }
    ]
  },
  {
    index: "02",
    discipline: "Numerics",
    title: "科学计算",
    detail: "覆盖数值实验、线性代数和可微分计算工作流。",
    groups: [
      { label: "Libraries", items: ["NumPy", "SciPy", "JAX"] },
      { label: "Methods", items: ["Linear Algebra", "Automatic Differentiation"] }
    ]
  },
  {
    index: "03",
    discipline: "Intelligence",
    title: "AI 与智能系统",
    detail: "面向个性化生成与多智能体协作的应用探索。",
    groups: [
      { label: "Systems", items: ["LLM Applications", "Multi-Agent Systems"] },
      { label: "Focus", items: ["Personalized Generation", "Agent Workflow"] }
    ]
  },
  {
    index: "04",
    discipline: "Quantum",
    title: "量子计算",
    detail: "研究变分算法、参数化量子电路与量子机器学习。",
    groups: [
      { label: "Framework", items: ["PennyLane"] },
      { label: "Algorithms", items: ["VQE", "PQC", "Quantum Circuits"] }
    ]
  },
  {
    index: "05",
    discipline: "Tensor",
    title: "张量网络",
    detail: "从表示、收缩到优化算法，服务于量子多体问题。",
    groups: [
      { label: "Models", items: ["MPS", "Tensor Network", "TensorGame"] },
      { label: "Methods", items: ["DMRG", "Tensor Contraction"] }
    ]
  },
  {
    index: "06",
    discipline: "Delivery",
    title: "Web 工程与交付",
    detail: "把研究内容与交互工具稳定地构建、发布和维护。",
    groups: [
      { label: "Web", items: ["Astro", "HTML / CSS", "Markdown"] },
      { label: "Delivery", items: ["GitHub Actions", "Cloudflare Workers", "GitHub Pages"] }
    ]
  }
];
const technicalCategories = new Set(["Tech Stack", "Engineering", "Programming"]);
const technicalPosts = publishedPosts(await getCollection("blog")).filter((post) => technicalCategories.has(post.data.category));
---

<BaseLayout title="Tech Stack" description="我的开发语言、科学计算工具、量子软件与交付工具链。">
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">Pillar 01 / Capabilities</p>
      <h1>我的技术栈</h1>
      <p>技术不是关键词清单，而是解决问题时能够组合使用的一套方法。</p>
    </header>
    <section class="stack-grid page-section section-compact" aria-label="技术栈">
      {stackGroups.map((group) => (
        <article class="stack-card">
          <div class="stack-card-meta">
            <span>{group.index}</span>
            <span>{group.discipline}</span>
          </div>
          <h2>{group.title}</h2>
          <p>{group.detail}</p>
          <div class="stack-divisions">
            {group.groups.map((division) => (
              <div class="stack-division">
                <h3>{division.label}</h3>
                <ul>{division.items.map((item) => <li>{item}</li>)}</ul>
              </div>
            ))}
          </div>
        </article>
      ))}
    </section>
    {technicalPosts.length > 0 && (
      <section class="page-section" aria-labelledby="stack-notes-title">
        <div class="section-heading"><div><p class="section-kicker">Practice</p><h2 id="stack-notes-title">相关记录</h2></div></div>
        <div class="post-grid">{technicalPosts.map((post) => <PostCard post={post} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>
