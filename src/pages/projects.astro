---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" description="个人项目、工程实验、算法实现与长期维护的工具。">
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">Pillar 04 / Selected work</p>
      <h1>我的项目</h1>
      <p>把技术与研究沉淀成可运行、可验证、可继续迭代的作品。</p>
    </header>
    <section class="projects-grid page-section" aria-label="项目列表">
      {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
    </section>
  </div>
</BaseLayout>
