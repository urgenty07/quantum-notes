---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import type { BlogPost } from "../utils/content";
import { formatDate, readingTime, slugifyTag, withBase } from "../utils/content";

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="article-shell container">
    <article class="article">
      <header class="article-header">
        <a class="eyebrow" href={withBase("/blog")}>← Notes</a>
        <h1>{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
          <span>{readingTime(post.body ?? "")} min read</span>
        </div>
        <div class="tag-row">
          {post.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${slugifyTag(tag)}`)}>#{tag}</a>)}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
    {toc.length > 0 && (
      <aside class="toc" aria-label="文章目录">
        <p>On this page</p>
        <ol>
          {toc.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</BaseLayout>
