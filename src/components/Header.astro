---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils/content";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" }
];

const active = (href: string) => {
  const path = withBase(href);
  return href === "/" ? pathname === path || pathname === `${path}/` : pathname.startsWith(path);
};
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href={withBase("/")} aria-label={`${siteConfig.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">Ψ</span>
      <span>{siteConfig.title}</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => (
        <a href={withBase(link.href)} aria-current={active(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-button" href={siteConfig.github} target="_blank" rel="noreferrer" aria-label="访问 GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.64 1.59.24 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
      </a>
      <ThemeToggle />
      <details class="mobile-menu">
        <summary aria-label="打开导航菜单"><span></span><span></span><span></span></summary>
        <nav aria-label="移动端导航">
          {links.map((link) => (
            <a href={withBase(link.href)} aria-current={active(link.href) ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
