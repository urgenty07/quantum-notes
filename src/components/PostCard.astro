---
import type { BlogPost } from "../utils/content";
import { formatDate, readingTime, slugifyTag, withBase } from "../utils/content";

interface Props {
  post: BlogPost;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
---

<article class:list={["post-card", { compact }]}>
  <div class="post-card-top">
    <div class="post-meta">
      <span>{post.data.category}</span>
      <span aria-hidden="true">/</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    </div>
    <span class="card-corner" aria-hidden="true">↗</span>
  </div>
  <h3><a href={withBase(`/blog/${post.id}`)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-card-footer">
    <div class="tag-row" aria-label="文章标签">
      {post.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${slugifyTag(tag)}`)}>#{tag}</a>)}
    </div>
    <span class="reading-time">{readingTime(post.body ?? "")} min</span>
  </div>
</article>
